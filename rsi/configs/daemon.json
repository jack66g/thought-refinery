{
  "llm": {
    "provider": "openai_compatible",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-flash",
    "api_key_env": "RSI_LLM_API_KEY",
    "reasoning_effort": "none",
    "temperature": 0.6,
    "max_tokens": 4096,
    "timeout_s": 120
  },
  "sme": {
    "base_url": "http://127.0.0.1:8000"
  },
  "daemon": {
    "host": "127.0.0.1",
    "port": 8100
  },
  "categories": ["math", "chinese", "code", "reasoning", "misc"],
  "value_gate": {
    "min_score": 6.0,
    "min_think_chars": 50,
    "max_think_chars": 60000,
    "verifiable_exempt": true
  },
  "cleaner": {
    "max_repeat_ratio": 0.3,
    "ngram_n": 10,
    "minor_lang_ratio": 0.35,
    "max_total_chars": 120000,
    "min_compress_ratio": 0.30,
    "max_loop_markers": 8
  },
  "dedup": {
    "minhash_perms": 128,
    "lsh_bands": 16,
    "jaccard_threshold": 0.8,
    "shingle_n": 5,
    "ngram_n": 10,
    "ngram_overlap_threshold": 0.7,
    "skeleton_keep_k": 2
  },
  "verify": {
    "self_consistency_n": 3,
    "self_consistency_min_agree": 2
  },
  "queue": {
    "max_len": 2000,
    "workers": 2
  },
  "self_propose": {
    "enabled": false,
    "idle_after_s": 120,
    "max_events_per_day": 200
  },
  "biodata": {
    "enabled": true
  },
  "self_explore": {
    "enabled": false,
    "max_missions_per_day": 5
  },
  "choice_mode": {
    "enabled": false,
    "open_browser": true,
    "rounds_per_day": 3,
    "min_profile_updates": 12,
    "min_memories": 6
  },
  "budget": {
    "daily_cost_cap": 5.0,
    "input_usd_per_million": 0.30,
    "output_usd_per_million": 1.20
  }
}
